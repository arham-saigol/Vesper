{
  "name": "vesper",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal PDF reader built with Electron, Vite, and React.",
  "author": "Vesper Team",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.vesper.reader",
    "productName": "Vesper",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.9.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "rimraf": "^6.0.1"
  }
}
